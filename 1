            "Not set",
            "Click Locate Me to see your local weather"
          );
        },
        { timeout: 8000 }
      );
    });
  }
  setIdleWeatherPrompt(
    "Not set",
    "Click Locate Me to see your local weather"
  );
  /* =========================================================
     3. ON THIS DAY IN MUSIC HISTORY — 1950s TO 1990s
     ========================================================= */
  const otdDateBadge = document.getElementById("sor-otd-date-badge");
  const otdBodyEl = document.getElementById("sor-otd-body");
  const MUSIC_CONTEXT_WORDS = [
    "album", "single", "song", "band", "singer", "musician",
    "guitarist", "drummer", "bassist", "pianist", "songwriter",
    "composer", "record label", "recording", "studio", "chart",
    "billboard", "uk singles", "uk albums", "number-one single",
    "number-one album", "no. 1", "concert", "tour", "festival",
    "woodstock", "live aid", "hall of fame", "grammy",
    "brit award", "vinyl", "gold record", "platinum", "pop",
    "rock", "soul", "motown", "disco", "punk", "grunge",
    "britpop", "hip hop", "jazz", "blues", "country"
  ];
  const ICONIC_50S_90S_ARTISTS = [
    "beatles", "john lennon", "paul mccartney",
    "george harrison", "ringo starr", "rolling stones",
    "mick jagger", "keith richards", "bob dylan",
    "elvis presley", "david bowie", "queen",
    "freddie mercury", "brian may", "elton john",
    "fleetwood mac", "stevie nicks", "abba", "bee gees",
    "pink floyd", "led zeppelin", "the who", "pete townshend",
    "keith moon", "the kinks", "beach boys", "aretha franklin",
    "stevie wonder", "marvin gaye", "motown", "the supremes",
    "michael jackson", "madonna", "prince", "whitney houston",
    "george michael", "u2", "the police", "sting", "oasis",
    "nirvana", "kurt cobain", "radiohead", "blur",
    "frank sinatra", "buddy holly", "chuck berry",
    "johnny cash", "bo diddley", "paul simon"
  ];
  const NON_MUSIC_BLOCKLIST = [
    "microsoft", "windows 1.0", "computer", "software",
    "operating system", "nasa", "spacecraft", "satellite",
    "apollo", "election", "president", "prime minister",
    "parliament", "senate", "court", "supreme court",
    "war", "battle", "treaty", "invasion", "olympic",
    "football", "soccer", "baseball", "basketball",
    "tennis", "golf", "championship", "world cup",
    "american actor", "british actor", "english actor",
    "television actor", "film actor", "child actor",
    "hannah montana", "disney channel"
  ];
  const NOV_20_MUSIC_EVENTS = [
    {
      year: 1955,
      text: '<strong>Bo Diddley</strong> performed "Bo Diddley" on <em>The Ed Sullivan Show</em> instead of the requested "Sixteen Tons," resulting in a ban from the programme.',
      page: "Bo Diddley"
    },
    {
      year: 1961,
      text: "<strong>Bob Dylan</strong> began recording his debut studio album at Columbia Records in New York City.",
      page: "Bob Dylan"
    },
    {
      year: 1965,
      text: '<strong>The Supremes</strong> reached No. 1 on the US chart with "I Hear a Symphony."',
      page: "I Hear a Symphony"
    },
    {
      year: 1973,
      text: "<strong>The Who</strong> drummer Keith Moon passed out onstage in San Francisco, and 19-year-old audience member Scott Halpin stepped in on drums for the closing songs.",
      page: "The Who"
    },
    {
      year: 1976,
      text: '<strong>Paul Simon</strong> hosted <em>Saturday Night Live</em> and performed "Homeward Bound" and "Here Comes the Sun" alongside <strong>George Harrison</strong>.',
      page: "Paul Simon"
    },
    {
      year: 1991,
      text: "<strong>The Rolling Stones</strong> signed a landmark three-album recording deal with Virgin Records.",
      page: "The Rolling Stones"
    }
  ];
  function getDecadeLabel(year) {
    const y = Number(year);
    if (y >= 1950 && y <= 1959) return "1950s Milestone";
    if (y >= 1960 && y <= 1969) return "1960s Milestone";
    if (y >= 1970 && y <= 1979) return "1970s Milestone";
    if (y >= 1980 && y <= 1989) return "1980s Milestone";
    if (y >= 1990 && y <= 1999) return "1990s Milestone";
    return "50s–90s Milestone";
  }
  function scoreMusicEntry(ev, isBirthList) {
    const y = Number(ev.year);
    if (y < 1950 || y > 1999) return -1;
    const lower = String(ev.text || "").toLowerCase();
    if (NON_MUSIC_BLOCKLIST.some((term) => lower.includes(term))) {
      return -1;
    }
    const hasMusicWord = MUSIC_CONTEXT_WORDS.some((word) =>
      lower.includes(word)
    );
    const hasIconicArtist = ICONIC_50S_90S_ARTISTS.some((artist) =>
      lower.includes(artist)
    );
    if (!hasMusicWord && !hasIconicArtist) return -1;
    if (isBirthList) return hasIconicArtist ? 2 : -1;
    if (hasMusicWord && hasIconicArtist) return 5;
    if (hasMusicWord) return 4;
    return 3;
  }
  function renderOnThisDay(year, text, imageUrl) {
    if (!otdBodyEl) return;
    const safeImage =
      imageUrl && /^https?:\/\//i.test(imageUrl)
        ? `<img class="sor-otd-image" src="${imageUrl}" alt="Photograph relating to this day in music history" loading="lazy" onerror="this.remove()">`
        : "";
    otdBodyEl.innerHTML = `
      <div class="sor-otd-top-row">
        <span class="sor-otd-year-badge">📅 ${year}</span>
        <span class="sor-otd-era-label">${getDecadeLabel(year)}</span>
      </div>
      <p class="sor-otd-text">${text}</p>
      ${safeImage}
    `;
  }
  /*
   * Retrieve a thumbnail from Wikipedia when the On This Day
   * event itself does not include an image.
   */
  async function getWikipediaImage(pageTitle) {
    if (!pageTitle) return "";
    try {
      const endpoint =
        "https://en.wikipedia.org/api/rest_v1/page/summary/" +
        encodeURIComponent(pageTitle.replace(/ /g, "_"));
      const response = await fetch(endpoint);
      if (!response.ok) return "";
      const data = await response.json();
      if (data.thumbnail && data.thumbnail.source) {
        return data.thumbnail.source;
      }
      if (data.originalimage && data.originalimage.source) {
        return data.originalimage.source;
      }
      return "";
    } catch (error) {
      return "";
    }
  }
  async function loadOnThisDayInMusic() {
    const formatter = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/London",
      month: "2-digit",
      day: "2-digit"
    });
    const parts = {};
    formatter.formatToParts(new Date()).forEach((part) => {
      parts[part.type] = part.value;
    });
    const mm = parts.month || "11";
    const dd = parts.day || "20";
    const displayLabel = new Date(
      Date.UTC(2026, Number(mm) - 1, Number(dd), 12)
    ).toLocaleDateString("en-GB", {
      timeZone: "UTC",
      day: "numeric",
      month: "short"
    }).toUpperCase();
    if (otdDateBadge) {
      otdDateBadge.textContent = displayLabel;
    }
    /* New cache version prevents old image-less entries persisting */
    const cacheKey = `sor_otd_music_v6_${mm}_${dd}`;
    try {
      const cached = localStorage.getItem(cacheKey);
      if (cached) {
        const parsed = JSON.parse(cached);
        if (
          parsed &&
          parsed.year &&
          parsed.text &&
          parsed.image
        ) {
          renderOnThisDay(parsed.year, parsed.text, parsed.image);
          return;
        }
      }
    } catch (error) {}
    try {
      const res = await fetch(
        `https://en.wikipedia.org/api/rest_v1/feed/onthisday/all/mm/{dd}`
      );
      if (!res.ok) {
        throw new Error("Wikipedia OTD HTTP " + res.status);
      }
      const data = await res.json();
      const eventPool = [
        ...(Array.isArray(data.selected) ? data.selected : []),
        ...(Array.isArray(data.events) ? data.events : [])
      ].map((event) => ({
        ev: event,
        score: scoreMusicEntry(event, false)
      })).filter((item) => item.score > 0);
      const birthPool = (
        Array.isArray(data.births) ? data.births : []
      ).map((event) => ({
        ev: event,
        score: scoreMusicEntry(event, true)
      })).filter((item) => item.score > 0);
      const ranked = (eventPool.length ? eventPool : birthPool)
        .sort((a, b) => b.score - a.score);
      if (ranked.length) {
        /*
         * Prefer events with an available image rather than choosing
         * an image-less event simply because it scored highly.
         */
        const imageCandidates = ranked.filter((item) => {
          const pages = Array.isArray(item.ev.pages)
            ? item.ev.pages
            : [];
          return pages.some((page) =>
            page.thumbnail && page.thumbnail.source
          );
        });
        const candidates = imageCandidates.length
          ? imageCandidates
          : ranked;
        const topScore = candidates[0].score;
        const topTier = candidates.filter(
          (item) => item.score === topScore
        );
        const chosen =
          topTier[Number(dd) % topTier.length].ev;
        const cleanText = String(chosen.text || "").trim();
        const pageWithImage = Array.isArray(chosen.pages)
          ? chosen.pages.find((page) =>
              page.thumbnail && page.thumbnail.source
            )
          : null;
        let imageUrl = pageWithImage
          ? pageWithImage.thumbnail.source
          : "";
        /*
         * If the chosen event has no thumbnail, try its Wikipedia page.
         */
        if (!imageUrl && Array.isArray(chosen.pages) && chosen.pages.length) {
          const pageTitle = chosen.pages[0].title;
          imageUrl = await getWikipediaImage(pageTitle);
        }
        const result = {
          year: chosen.year,
          text: cleanText,
          image: imageUrl
        };
        /*
         * Only cache results when an image was found.
         * This allows another attempt if Wikipedia has no image today.
         */
        if (imageUrl) {
          try {
            localStorage.setItem(
              cacheKey,
              JSON.stringify(result)
            );
          } catch (error) {}
        }
        renderOnThisDay(
          chosen.year,
          cleanText,
          imageUrl
        );
        return;
      }
    } catch (error) {}
    /*
     * Special date fallback for 20 November.
     */
    if (mm === "11" && dd === "20") {
      const todayEvent =
        NOV_20_MUSIC_EVENTS[
          new Date().getDate() % NOV_20_MUSIC_EVENTS.length
        ];
      let imageUrl = await getWikipediaImage(todayEvent.page);
      renderOnThisDay(
        todayEvent.year,
        todayEvent.text,
        imageUrl
      );
      return;
    }
    /*
     * General fallback if Wikipedia has no suitable event.
     */
    const fallback =
      NOV_20_MUSIC_EVENTS[
        (Number(dd) + Number(mm)) % NOV_20_MUSIC_EVENTS.length
      ];
    const fallbackImage = await getWikipediaImage(fallback.page);
    renderOnThisDay(
      fallback.year,
      fallback.text,
      fallbackImage
    );
  }
  loadOnThisDayInMusic();
})();
